generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
   url      = env("DATABASE_URL")
}

model UVGuidance {
  guidance_id           Int     @id @default(autoincrement())
  uv_min                Float
  uv_max                Float
  risk_level            String
  human_alert_template  String
  clothing_text         String
  sunscreen_dosage_text String
  reapply_minutes       Int
}